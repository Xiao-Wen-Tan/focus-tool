#!/bin/sh
# Pre-commit hook: refuses the commit if any staged file would leak your real
# task data into this PUBLIC repo. See tools/check_public.py for what it checks.
#
# Install it once per computer, from the repo folder:
#   python tools/install_hooks.py
# That copies this file into the folder `git rev-parse --git-path hooks` names,
# which works even though this repo keeps its git folder outside Box.

repo_root=$(git rev-parse --show-toplevel) || exit 1

venv_py="$LOCALAPPDATA/FocusTool/venv/Scripts/python.exe"
if [ -x "$venv_py" ]; then
    py="$venv_py"
elif command -v python >/dev/null 2>&1; then
    py="python"
else
    py="python3"
fi

"$py" "$repo_root/tools/check_public.py" --staged --repo-root "$repo_root"
exit $?
